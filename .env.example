# Copy this file to .env and fill in the tokens from my.akahu.nz -> Developers.
# Never commit .env.
AKAHU_APP_TOKEN=app_token_...
AKAHU_USER_TOKEN=user_token_...

# Your main savings account (used for the savings projection)
SAVINGS_ACCOUNT=XX-XXXX-XXXXXXX-XX

# Text that identifies your salary deposits; only these count as income
INCOME_MATCH=Employer Salaries

# Comma-separated text identifying money to/from investments; left out of income and spending
INVESTMENT_MATCH=Investment Platform, Managed Fund

# Optional
# PAYDAY=2026-10-07   (any payday; normally detected automatically)
# TIMEZONE=Pacific/Auckland
# DB_PATH=data/finance.db
